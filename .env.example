# Free key from https://resend.com — required for the contact form to deliver mail
RESEND_API_KEY=re_xxxxxxxx

# Optional. Defaults to Resend's onboarding sender (can only reach the Resend account email).
# After you verify a domain in Resend, set e.g. CONTACT_FROM_EMAIL="Zakir <hello@yourdomain.com>"
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
